# DataPilot AI Environment Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Storage directories
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
SAMPLES_DIR=./data/samples

# Optional LLM Configuration (Deterministic NLP fallback runs 100% locally if not configured)
LLM_PROVIDER=none # 'none', 'gemini', 'openai', 'anthropic', 'ollama'
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security & Limits
MAX_UPLOAD_SIZE_MB=250
QUERY_TIMEOUT_SECONDS=60
MAX_PREVIEW_ROWS=1000
